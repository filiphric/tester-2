# Public reaction Worker hostname, without a protocol or path. Local dev defaults to localhost:1999.
VITE_REACTIONS_HOST=
# Use a different room for each event; ?room=... overrides this on both the deck and /live.
VITE_REACTIONS_ROOM=tester-2
# Public audience page. Set this when presenting locally so the QR code points to your deployed site.
VITE_REACTIONS_JOIN_URL=https://slides.filiphric.com/tester-2/live
# Optional public sources URL. Defaults to /sources beside the public audience page.
VITE_SOURCES_URL=
